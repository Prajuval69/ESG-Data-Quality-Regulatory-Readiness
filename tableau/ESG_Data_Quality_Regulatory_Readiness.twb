      <column datatype="real" name="[Validity_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Consistency_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Traceability_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Data_Quality_Score]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Exception_Count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[High_Critical_Exception_Count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Reporting_Year]" role="measure" type="quantitative" />
      <column datatype="date" name="[Period_Date]" role="dimension" type="ordinal" />
