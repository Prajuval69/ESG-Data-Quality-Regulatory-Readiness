    <datasource caption="Issues" inline="true" name="ds.issues" version="18.1">
      <connection class="textscan" directory="Data" filename="tableau_issues.csv" server="" workgroup-auth-mode="as-is" />
      <aliases enabled="yes" />
      <column datatype="string" name="[Exception_ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Record_ID]" role="dimension" type="nominal" />
      <column datatype="string" name="[Company]" role="dimension" type="nominal" />
      <column datatype="string" name="[Industry]" role="dimension" type="nominal" />
      <column datatype="string" name="[Country]" role="dimension" type="nominal" />
      <column datatype="real" name="[Reporting_Year]" role="measure" type="quantitative" />
      <column datatype="string" name="[ESG_Category]" role="dimension" type="nominal" />
      <column datatype="string" name="[Metric]" role="dimension" type="nominal" />
