      <column datatype="string" name="[Requirement_Area]" role="dimension" type="nominal" />
      <column datatype="string" name="[Required_Data]" role="dimension" type="nominal" />
      <column datatype="string" name="[Availability]" role="dimension" type="nominal" />
      <column datatype="integer" name="[Availability_Flag]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Requirement_Count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Gap_Flag]" role="measure" type="quantitative" />
      <column datatype="real" name="[Regulatory_Coverage_Pct]" role="measure" type="quantitative" />
