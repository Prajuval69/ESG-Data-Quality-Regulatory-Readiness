      <column datatype="integer" name="[Available_Company_Years]" role="measure" type="quantitative" />
      <column datatype="real" name="[Completeness_Pct]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="Scope" inline="true" name="ds.scope" version="18.1">
      <connection class="textscan" directory="Data" filename="tableau_scope_completeness.csv" server="" workgroup-auth-mode="as-is" />
      <aliases enabled="yes" />
      <column datatype="string" name="[Metric]" role="dimension" type="nominal" />
      <column datatype="real" name="[Completeness_Pct]" role="measure" type="quantitative" />
