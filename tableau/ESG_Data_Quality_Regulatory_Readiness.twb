<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" source-build="portfolio" source-platform="win" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <document-format-change-manifest>
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences />
  <datasources>
    <datasource caption="Summary" inline="true" name="ds.summary" version="18.1">
      <connection class="textscan" directory="Data" filename="esg_quality_summary.csv" server="" workgroup-auth-mode="as-is" />
      <aliases enabled="yes" />
      <column datatype="string" name="[Scope]" role="dimension" type="nominal" />
      <column datatype="integer" name="[Total_Records]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Valid_Records]" role="measure" type="quantitative" />
      <column datatype="real" name="[Record_Pass_Rate]" role="measure" type="quantitative" />
      <column datatype="real" name="[Completeness_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Validity_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Consistency_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Traceability_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Data_Quality_Score]" role="measure" type="quantitative" />
      <column datatype="integer" name="[Exception_Count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[High_Critical_Exception_Count]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="Year" inline="true" name="ds.year" version="18.1">
      <connection class="textscan" directory="Data" filename="tableau_year_summary.csv" server="" workgroup-auth-mode="as-is" />
