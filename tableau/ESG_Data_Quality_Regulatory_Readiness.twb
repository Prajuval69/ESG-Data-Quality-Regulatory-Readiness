      <column datatype="string" name="[Original_Unit]" role="dimension" type="nominal" />
      <column datatype="string" name="[Description]" role="dimension" type="nominal" />
      <column datatype="string" name="[Recommended_Action]" role="dimension" type="nominal" />
      <column datatype="string" name="[Remediation_Status]" role="dimension" type="nominal" />
      <column datatype="integer" name="[Exception_Count]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="Completeness" inline="true" name="ds.completeness" version="18.1">
      <connection class="textscan" directory="Data" filename="tableau_metric_completeness.csv" server="" workgroup-auth-mode="as-is" />
      <aliases enabled="yes" />
