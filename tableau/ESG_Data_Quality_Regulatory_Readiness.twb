          <style-rule element="cell">
            <format attr="height" field="[ds.readiness].[none:Requirement_Area:nk]" value="40" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="background-color" value="#FFFFFF" />
            <format attr="font-face" value="Tableau Book" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <encodings>
              <color column="[ds.readiness].[none:Availability:nk]" />
            </encodings>
            <style>
              <style-rule element="pane">
                <format attr="minheight" value="-1" />
                <format attr="maxheight" value="-1" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[ds.readiness].[none:Requirement_Area:nk]</rows>
        <cols>[ds.readiness].[sum:Requirement_Count:qk]</cols>
      </table>
    </worksheet>
