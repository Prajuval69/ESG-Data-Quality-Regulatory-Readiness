      <column datatype="real" name="[Validity_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Consistency_Pct]" role="measure" type="quantitative" />
      <column datatype="real" name="[Traceability_Pct]" role="measure" type="quantitative" />
