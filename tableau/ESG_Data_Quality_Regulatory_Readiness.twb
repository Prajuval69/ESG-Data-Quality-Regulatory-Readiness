      <column datatype="string" name="[Recommended_Action]" role="dimension" type="nominal" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="KPI | Data Quality Score">
      <table>
        <view>
          <datasources>
            <datasource caption="Summary" name="ds.summary" />
          </datasources>
          <datasource-dependencies datasource="ds.summary">
            <column datatype="real" name="[Data_Quality_Score]" role="measure" type="quantitative" />
            <column-instance column="[Data_Quality_Score]" derivation="Sum" name="[sum:Data_Quality_Score:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="worksheet">
            <format attr="background-color" value="#FFFFFF" />
            <format attr="font-face" value="Tableau Book" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Automatic" />
            <encodings>
              <text column="[ds.summary].[sum:Data_Quality_Score:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
            <style>
              <style-rule element="mark">
                <format attr="font-size" value="22" />
                <format attr="font-weight" value="bold" />
                <format attr="color" value="#17324D" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
